  {
    "id": "fn_process_face",
    "type": "function",
    "z": "tab_smartlock",
    "name": "Process Face",
    "func": "// Get raw payload\nvar raw = '';\nif (typeof msg.payload === 'string') {\n    raw = msg.payload.trim();\n} else {\n    raw = String(msg.payload).trim();\n}\n\nnode.warn('FACE TOPIC RECEIVED: ' + raw);\n\nvar ts  = new Date().toLocaleString('en-MY');\nvar ctx = context.get('state') || {\n    granted: 0, denied: 0, fails: 0,\n    lockout: false, door: 'LOCKED',\n    face: '', faceStatus: 'Waiting...',\n    pinStatus: 'Waiting...'\n};\n\nvar update = {};\n\nif (raw.indexOf('FACE_OK') >= 0) {\n    var name = '';\n    if (raw.indexOf(':') >= 0) {\n        name = raw.split(':')[1] || 'USER';\n    } else {\n        name = 'USER';\n    }\n    name = name.trim();\n    ctx.face       = name;\n    ctx.faceStatus = 'recognized';\n\n    update = {\n        action:     'face_ok',\n        name:       name,\n        ts:         ts,\n        granted:    ctx.granted,\n        denied:     ctx.denied,\n        fails:      ctx.fails,\n        lockout:    ctx.lockout,\n        door:       ctx.door,\n        faceStatus: ctx.faceStatus,\n        pinStatus:  ctx.pinStatus\n    };\n\n} else {\n    ctx.fails++;\n    ctx.denied++;\n    ctx.faceStatus = 'unknown';\n\n    update = {\n        action:     'face_fail',\n        name:       '',\n        ts:         ts,\n        granted:    ctx.granted,\n        denied:     ctx.denied,\n        fails:      ctx.fails,\n        lockout:    ctx.fails >= 3,\n        door:       ctx.door,\n        faceStatus: ctx.faceStatus,\n        pinStatus:  ctx.pinStatus\n    };\n\n    if (ctx.fails >= 3) {\n        ctx.lockout = true;\n    }\n}\n\ncontext.set('state', ctx);\nmsg.payload = update;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [["node_dashboard", "debug_face"]]
  },
  {
    "id": "fn_process_status",
    "type": "function",
    "z": "tab_smartlock",
    "name": "Process Status",
    "func": "var raw = '';\nif (typeof msg.payload === 'string') {\n    raw = msg.payload.trim();\n} else {\n    raw = String(msg.payload).trim();\n}\n\nnode.warn('STATUS TOPIC RECEIVED: ' + raw);\n\nvar ts  = new Date().toLocaleString('en-MY');\nvar ctx = context.get('state') || {\n    granted: 0, denied: 0, fails: 0,\n    lockout: false, door: 'LOCKED',\n    face: '', faceStatus: 'Waiting...',\n    pinStatus: 'Waiting...'\n};\n\nvar update = {};\n\nif (raw === 'UNLOCKED') {\n    ctx.granted++;\n    ctx.fails      = 0;\n    ctx.lockout    = false;\n    ctx.door       = 'UNLOCKED';\n    ctx.pinStatus  = 'correct';\n\n    update = {\n        action:     'unlocked',\n        ts:         ts,\n        granted:    ctx.granted,\n        denied:     ctx.denied,\n        fails:      ctx.fails,\n        lockout:    ctx.lockout,\n        door:       ctx.door,\n        faceStatus: ctx.faceStatus,\n        pinStatus:  ctx.pinStatus,\n        name:       ctx.face\n    };\n\n} else if (raw === 'WRONG_PIN') {\n    ctx.fails++;\n    ctx.denied++;\n    ctx.pinStatus = 'wrong';\n\n    if (ctx.fails >= 3) ctx.lockout = true;\n\n    update = {\n        action:     'wrong_pin',\n        ts:         ts,\n        granted:    ctx.granted,\n        denied:     ctx.denied,\n        fails:      ctx.fails,\n        lockout:    ctx.lockout,\n        door:       ctx.door,\n        faceStatus: ctx.faceStatus,\n        pinStatus:  ctx.pinStatus,\n        name:       ctx.face\n    };\n\n} else if (raw === 'LOCKED') {\n    ctx.door      = 'LOCKED';\n    ctx.pinStatus = 'Waiting...';\n    ctx.faceStatus= 'Waiting...';\n    ctx.face      = '';\n\n    update = {\n        action:     'locked',\n        ts:         ts,\n        granted:    ctx.granted,\n        denied:     ctx.denied,\n        fails:      ctx.fails,\n        lockout:    ctx.lockout,\n        door:       ctx.door,\n        faceStatus: ctx.faceStatus,\n        pinStatus:  ctx.pinStatus,\n        name:       ''\n    };\n}\n\ncontext.set('state', ctx);\nmsg.payload = update;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 180,
    "wires": [["node_dashboard", "debug_status"]]
  },
  {
    "id": "fn_process_override",
    "type": "function",
    "z": "tab_smartlock",
    "name": "Process Override",
    "func": "var raw = '';\nif (typeof msg.payload === 'string') {\n    raw = msg.payload.trim();\n} else {\n    raw = String(msg.payload).trim();\n}\n\nvar action = raw;\ntry {\n    var parsed = JSON.parse(raw);\n    action = parsed.action || raw;\n} catch(e) {}\n\nvar ts  = new Date().toLocaleString('en-MY');\nvar ctx = context.get('state') || {\n    granted: 0, denied: 0, fails: 0,\n    lockout: false, door: 'LOCKED',\n    face: '', faceStatus: 'Waiting...',\n    pinStatus: 'Waiting...'\n};\n\nvar update = {};\n\nif (action === 'unlock') {\n    ctx.door = 'UNLOCKED';\n    update = { action:'override_unlock', door:'UNLOCKED', ts:ts, granted:ctx.granted, denied:ctx.denied, fails:ctx.fails, lockout:ctx.lockout, faceStatus:ctx.faceStatus, pinStatus:ctx.pinStatus, name:ctx.face };\n} else if (action === 'lock') {\n    ctx.door = 'LOCKED';\n    update = { action:'override_lock', door:'LOCKED', ts:ts, granted:ctx.granted, denied:ctx.denied, fails:ctx.fails, lockout:ctx.lockout, faceStatus:ctx.faceStatus, pinStatus:ctx.pinStatus, name:ctx.face };\n} else if (action === 'reset') {\n    ctx.fails   = 0;\n    ctx.lockout = false;\n    ctx.faceStatus = 'Waiting...';\n    ctx.pinStatus  = 'Waiting...';\n    ctx.face = '';\n    update = { action:'reset', door:ctx.door, ts:ts, granted:ctx.granted, denied:ctx.denied, fails:0, lockout:false, faceStatus:'Waiting...', pinStatus:'Waiting...', name:'' };\n}\n\ncontext.set('state', ctx);\nmsg.payload = update;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 260,
    "wires": [["node_dashboard"]]
  },
