  {
    "id": "node_dashboard",
    "type": "ui_template",
    "z": "tab_smartlock",
    "group": "ui_grp_main",
    "name": "SmartLock Dashboard",
    "order": 1,
    "width": "12",
    "height": "24",
    "format": "<style>\n*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif}\n#app{min-height:100vh;background:linear-gradient(135deg,#1565C0,#0D47A1,#1a237e);display:flex;align-items:center;justify-content:center;padding:20px}\n\n/* LOGIN */\n#lp{width:100%;display:flex;align-items:center;justify-content:center}\n.lcard{background:#fff;border-radius:20px;padding:40px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,.3)}\n.llogo{text-align:center;font-size:52px;margin-bottom:10px}\n.ltitle{text-align:center;font-size:22px;font-weight:bold;color:#1565C0;margin-bottom:4px}\n.lsub{text-align:center;font-size:12px;color:#999;margin-bottom:24px}\n.iw{position:relative;margin-bottom:12px}\n.ii{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:15px}\n.inp{width:100%;padding:12px 12px 12px 38px;border:1.5px solid #e0e0e0;border-radius:10px;font-size:14px;outline:none;transition:border .2s}\n.inp:focus{border-color:#1565C0}\n.btnl{width:100%;padding:13px;background:#1565C0;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:bold;cursor:pointer;margin-top:4px;transition:background .2s}\n.btnl:hover{background:#0D47A1}\n.errmsg{color:#C62828;font-size:12px;text-align:center;margin-top:10px;display:none;padding:8px;background:#FFEBEE;border-radius:8px}\n.role-badge{text-align:center;margin-top:12px;font-size:11px;color:#999}\n\n/* DASHBOARD */\n#dp{display:none;width:100%;max-width:960px}\n.dh{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}\n.dleft .dtitle{font-size:20px;font-weight:bold;color:#fff}\n.dleft .dsub{font-size:12px;color:rgba(255,255,255,.7);margin-top:2px}\n.dright{display:flex;align-items:center;gap:10px}\n.role-tag{padding:4px 12px;border-radius:20px;font-size:11px;font-weight:bold;background:rgba(255,255,255,.2);color:#fff}\n.btnout{padding:8px 16px;background:rgba(255,255,255,.15);color:#fff;border:1.5px solid rgba(255,255,255,.4);border-radius:8px;font-size:12px;cursor:pointer}\n.btnout:hover{background:rgba(255,255,255,.25)}\n\n/* ALERT */\n.alert-bar{display:none;padding:10px 14px;background:#FFEBEE;border:1px solid #EF9A9A;border-radius:10px;color:#C62828;font-weight:600;font-size:13px;margin-bottom:14px;animation:fadeIn .3s}\n@keyframes fadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}\n\n/* STATS */\n.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}\n.sbox{background:#fff;border-radius:12px;padding:14px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.1)}\n.sval{font-size:26px;font-weight:bold;color:#1565C0}\n.slbl{font-size:11px;color:#999;margin-top:3px}\n\n/* AUTH STATUS */\n.auth-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}\n.acard{background:#fff;border-radius:12px;padding:16px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.1)}\n.aicon{font-size:28px;margin-bottom:6px}\n.atitle{font-size:11px;color:#999;margin-bottom:6px;text-transform:uppercase;letter-spacing:1px}\n.aval{font-size:14px;font-weight:bold;color:#333;transition:all .3s}\n\n/* DOOR */\n.door-row{display:flex;gap:14px;margin-bottom:14px;flex-wrap:wrap}\n.sc{flex:1;min-width:160px}\n.cc{flex:2;min-width:260px}\n.card{background:#fff;border-radius:14px;padding:20px;box-shadow:0 4px 16px rgba(0,0,0,.12)}\n.clbl{font-size:11px;color:#999;margin-bottom:12px;font-weight:600;text-transform:uppercase;letter-spacing:1px}\n.sbadge{font-size:18px;font-weight:bold;padding:12px 20px;border-radius:10px;display:inline-block;transition:all .4s}\n.locked{background:#E3F2FD;color:#1565C0}\n.unlocked{background:#E8F5E9;color:#1B5E20}\n.brow{display:flex;gap:8px;flex-wrap:wrap}\n.blk{flex:1;min-width:80px;padding:12px 8px;background:#1565C0;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:bold;cursor:pointer;transition:background .2s}\n.blk:hover{background:#0D47A1}\n.bul{flex:1;min-width:80px;padding:12px 8px;background:#C62828;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:bold;cursor:pointer;transition:background .2s}\n.bul:hover{background:#B71C1C}\n.brst{flex:1;min-width:80px;padding:12px 8px;background:#37474F;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:bold;cursor:pointer;transition:background .2s}\n.brst:hover{background:#263238}\n\n/* Admin only controls */\n.admin-only{display:none}\n\n/* LOG */\n.lc{width:100%}\n.lh{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\n.ltitle{font-size:14px;font-weight:bold;color:#333}\n.lcnt{font-size:11px;color:#999;background:#f5f5f5;padding:3px 10px;border-radius:20px}\n.le{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid #f5f5f5;font-size:13px}\n.le:last-child{border-bottom:none}\n.lb{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:bold;min-width:64px;text-align:center;flex-shrink:0}\n.lg{background:#E8F5E9;color:#1B5E20}\n.ld{background:#FFEBEE;color:#C62828}\n.lf{background:#F3E5F5;color:#6A1B9A}\n.lo{background:#FFF8E1;color:#F57F17}\n.ll{background:#E3F2FD;color:#1565C0}\n.lr{background:#FFF3E0;color:#E65100}\n.lt{color:#555;flex:1}\n.ltm{color:#bbb;font-size:11px;flex-shrink:0}\n.elog{text-align:center;color:#bbb;font-size:13px;padding:20px 0}\n</style>\n\n<div id='app'>\n  <!-- LOGIN -->\n  <div id='lp'>\n    <div class='lcard'>\n      <div class='llogo'>🔐</div>\n      <div class='ltitle'>SmartLock System</div>\n      <div class='lsub'>Biometric & Keypad Access Control</div>\n      <div class='iw'><span class='ii'>👤</span><input class='inp' type='text' id='un' placeholder='Username' autocomplete='off'/></div>\n      <div class='iw'><span class='ii'>🔑</span><input class='inp' type='password' id='pw' placeholder='Password' onkeypress='if(event.key===\"Enter\")login()'/></div>\n      <button class='btnl' onclick='login()'>Sign In →</button>\n      <div class='errmsg' id='em'>❌ Wrong username or password</div>\n      <div class='role-badge'>Login as admin or user</div>\n    </div>\n  </div>\n\n  <!-- DASHBOARD -->\n  <div id='dp'>\n    <div class='dh'>\n      <div class='dleft'>\n        <div class='dtitle'>🔐 SmartLock Dashboard</div>\n        <div class='dsub' id='wlc'>Welcome</div>\n      </div>\n      <div class='dright'>\n        <span class='role-tag' id='rtag'>USER</span>\n        <button class='btnout' onclick='logout()'>⬅ Logout</button>\n      </div>\n    </div>\n\n    <div class='alert-bar' id='ab'></div>\n\n    <!-- STATS -->\n    <div class='stat-row'>\n      <div class='sbox'><div class='sval' id='sg'>0</div><div class='slbl'>Granted</div></div>\n      <div class='sbox'><div class='sval' id='sd' style='color:#C62828'>0</div><div class='slbl'>Denied</div></div>\n      <div class='sbox'><div class='sval' id='sf' style='color:#F57F17'>0</div><div class='slbl'>Failed</div></div>\n      <div class='sbox'><div class='sval' id='slk' style='color:#2E7D32;font-size:16px'>NO</div><div class='slbl'>Lockout</div></div>\n    </div>\n\n    <!-- AUTH STATUS -->\n    <div class='auth-row'>\n      <div class='acard'>\n        <div class='aicon'>👤</div>\n        <div class='atitle'>Face Recognition</div>\n        <div class='aval' id='aface'>Waiting...</div>\n      </div>\n      <div class='acard'>\n        <div class='aicon'>🔢</div>\n        <div class='atitle'>PIN Verification</div>\n        <div class='aval' id='apin'>Waiting...</div>\n      </div>\n    </div>\n\n    <!-- DOOR STATUS + CONTROL -->\n    <div class='door-row'>\n      <div class='card sc'>\n        <div class='clbl'>Door Status</div>\n        <span class='sbadge locked' id='stb'>🔒 LOCKED</span>\n      </div>\n      <div class='card cc admin-only' id='ctrl-card'>\n        <div class='clbl'>Door Control (Admin)</div>\n        <div class='brow'>\n          <button class='blk' onclick='doLock()'>🔒 LOCK</button>\n          <button class='bul' onclick='doUnlock()'>🔓 UNLOCK</button>\n          <button class='brst' onclick='doReset()'>↺ RESET</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ACCESS LOG -->\n    <div class='card lc'>\n      <div class='lh'>\n        <div class='ltitle'>📋 Access Log</div>\n        <div class='lcnt' id='lct'>0 events</div>\n      </div>\n      <div id='ll'><div class='elog'>No events yet. Waiting for authentication...</div></div>\n    </div>\n  </div>\n</div>\n\n<script>\n// ── Users ─────────────────────────────────\nvar USERS = {\n    admin: { password: '12345', role: 'admin' },\n    user:  { password: '1234',  role: 'user'  }\n};\n\n// ── State ─────────────────────────────────\nvar logs    = [];\nvar cu      = '';\nvar curRole = '';\n\n// ── Login / Logout ────────────────────────\nfunction login() {\n    var u = document.getElementById('un').value.trim();\n    var p = document.getElementById('pw').value;\n\n    if (USERS[u] && USERS[u].password === p) {\n        cu      = u;\n        curRole = USERS[u].role;\n\n        document.getElementById('lp').style.display = 'none';\n        document.getElementById('dp').style.display = 'block';\n        document.getElementById('wlc').textContent  = 'Welcome, ' + u;\n        document.getElementById('rtag').textContent = curRole.toUpperCase();\n        document.getElementById('em').style.display = 'none';\n\n        // Show admin controls only for admin\n        if (curRole === 'admin') {\n            document.getElementById('ctrl-card').style.display = 'block';\n        } else {\n            document.getElementById('ctrl-card').style.display = 'none';\n        }\n\n        addLog('LOGIN', u + ' logged in as ' + curRole, 'lr');\n    } else {\n        document.getElementById('em').style.display = 'block';\n    }\n}\n\nfunction logout() {\n    addLog('LOGOUT', cu + ' logged out', 'lo');\n    cu = ''; curRole = '';\n    document.getElementById('lp').style.display = 'flex';\n    document.getElementById('dp').style.display = 'none';\n    document.getElementById('un').value = '';\n    document.getElementById('pw').value = '';\n    document.getElementById('ctrl-card').style.display = 'none';\n}\n\n// ── Door Control (admin only) ─────────────\nfunction doLock() {\n    if (curRole !== 'admin') return;\n    setDoor(false);\n    addLog('LOCK', 'Door locked by admin', 'll');\n    sendMqtt(JSON.stringify({ action: 'lock' }));\n}\n\nfunction doUnlock() {\n    if (curRole !== 'admin') return;\n    setDoor(true);\n    addLog('UNLOCK', 'Door unlocked by admin', 'lo');\n    sendMqtt(JSON.stringify({ action: 'unlock' }));\n}\n\nfunction doReset() {\n    if (curRole !== 'admin') return;\n    document.getElementById('sf').textContent  = '0';\n    document.getElementById('slk').textContent = 'NO';\n    document.getElementById('slk').style.color = '#2E7D32';\n    document.getElementById('aface').textContent = 'Waiting...';\n    document.getElementById('aface').style.color = '#333';\n    document.getElementById('apin').textContent  = 'Waiting...';\n    document.getElementById('apin').style.color  = '#333';\n    addLog('RESET', 'System reset by admin', 'lo');\n    sendMqtt(JSON.stringify({ action: 'reset' }));\n}\n\nfunction sendMqtt(payload) {\n    try {\n        if (typeof $scope !== 'undefined' && $scope.send) {\n            $scope.send({ payload: payload, topic: 'smartlock/override' });\n        }\n    } catch(e) { console.log('Send error:', e); }\n}\n\n// ── UI Helpers ────────────────────────────\nfunction setDoor(unlocked) {\n    var b = document.getElementById('stb');\n    b.textContent = unlocked ? '🔓 UNLOCKED' : '🔒 LOCKED';\n    b.className   = 'sbadge ' + (unlocked ? 'unlocked' : 'locked');\n}\n\nfunction showAlert(msg) {\n    var b = document.getElementById('ab');\n    b.textContent    = msg;\n    b.style.display  = 'block';\n    setTimeout(function() { b.style.display = 'none'; }, 7000);\n}\n\nfunction addLog(badge, msg, cls) {\n    var now = new Date().toLocaleString('en-MY');\n    logs.unshift({ badge: badge, msg: msg, cls: cls, time: now });\n    if (logs.length > 30) logs = logs.slice(0, 30);\n    document.getElementById('lct').textContent = logs.length + ' events';\n    document.getElementById('ll').innerHTML = logs.map(function(l) {\n        return '<div class=\"le\"><span class=\"lb ' + l.cls + '\">' + l.badge + '</span>' +\n               '<span class=\"lt\">' + l.msg + '</span>' +\n               '<span class=\"ltm\">' + l.time + '</span></div>';\n    }).join('');\n}\n\n// ── Handle Incoming MQTT Data ─────────────\nfunction handleMsg(d) {\n    if (!d) return;\n\n    // Update stats\n    if (d.granted  !== undefined) { document.getElementById('sg').textContent = d.granted; }\n    if (d.denied   !== undefined) { document.getElementById('sd').textContent = d.denied; }\n    if (d.fails    !== undefined) {\n        document.getElementById('sf').textContent  = d.fails;\n        document.getElementById('sf').style.color  = d.fails >= 2 ? '#C62828' : '#F57F17';\n    }\n    if (d.lockout  !== undefined) {\n        var le = document.getElementById('slk');\n        le.textContent  = d.lockout ? 'YES' : 'NO';\n        le.style.color  = d.lockout ? '#C62828' : '#2E7D32';\n        if (d.lockout) showAlert('🚨 SECURITY ALERT: System locked out! 3 failed attempts detected.');\n    }\n    if (d.door !== undefined) { setDoor(d.door === 'UNLOCKED'); }\n\n    // Action-specific updates\n    var action = d.action || '';\n\n    if (action === 'face_ok') {\n        var name = d.name || 'USER';\n        document.getElementById('aface').textContent = '✅ ' + name;\n        document.getElementById('aface').style.color = '#1B5E20';\n        document.getElementById('apin').textContent  = 'Waiting for PIN...';\n        document.getElementById('apin').style.color  = '#F57F17';\n        addLog('FACE OK', 'Face recognized: ' + name, 'lf');\n    }\n    else if (action === 'face_fail') {\n        document.getElementById('aface').textContent = '❌ Unknown Face';\n        document.getElementById('aface').style.color = '#C62828';\n        addLog('DENIED', 'Unknown face detected', 'ld');\n    }\n    else if (action === 'unlocked') {\n        document.getElementById('apin').textContent = '✅ Correct';\n        document.getElementById('apin').style.color = '#1B5E20';\n        addLog('GRANTED', 'Access granted — ' + (d.name || 'user') + ' (Face + PIN)', 'lg');\n    }\n    else if (action === 'wrong_pin') {\n        document.getElementById('apin').textContent = '❌ Wrong PIN (attempt ' + d.fails + ')';\n        document.getElementById('apin').style.color = '#C62828';\n        addLog('DENIED', 'Wrong PIN entered (attempt ' + d.fails + ')', 'ld');\n    }\n    else if (action === 'locked') {\n        document.getElementById('aface').textContent = 'Waiting...';\n        document.getElementById('aface').style.color = '#333';\n        document.getElementById('apin').textContent  = 'Waiting...';\n        document.getElementById('apin').style.color  = '#333';\n        addLog('LOCKED', 'Door auto-locked', 'll');\n    }\n    else if (action === 'override_unlock') {\n        addLog('OVERRIDE', 'Door unlocked by admin', 'lo');\n    }\n    else if (action === 'override_lock') {\n        addLog('OVERRIDE', 'Door locked by admin', 'lo');\n    }\n    else if (action === 'reset') {\n        document.getElementById('aface').textContent = 'Waiting...';\n        document.getElementById('aface').style.color = '#333';\n        document.getElementById('apin').textContent  = 'Waiting...';\n        document.getElementById('apin').style.color  = '#333';\n        addLog('RESET', 'System reset', 'lo');\n    }\n    else if (action === 'startup') {\n        setDoor(false);\n    }\n}\n\n// ── Watch for Node-RED messages ───────────\nif (typeof $scope !== 'undefined') {\n    $scope.$watch('msg', function(msg) {\n        if (msg && msg.payload) {\n            handleMsg(msg.payload);\n        }\n    });\n}\n</script>",
    "storeOutMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 640,
    "y": 300,
    "wires": [["mqtt_out_override"]]
  }
]
